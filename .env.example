[TEMPLATE]
# ReviewBoost — Environment Variables
# Copy this file to .env and fill in the values.
# Never commit .env to version control.

# Resend API Key (required for email delivery)
# Get yours at: https://resend.com/api-keys
RESEND_API_KEY=

# Contact email — where business inquiries are sent
# Example: hello@reviewboost.lt
CONTACT_EMAIL=

# From email — sender address for emails
# Must be from a verified Resend domain
# Example: noreply@reviewboost.lt
FROM_EMAIL=
